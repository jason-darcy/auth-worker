{
  "openapi": "3.1.0",
  "info": {
    "title": "auth-worker API",
    "version": "1.0.0",
    "description": "Self-hosted authentication API. Every JSON response uses the same envelope: `{ success, errors, messages, results }`. Errors always carry the human readable reason in `messages`; `errors` is reserved and currently `null`.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "registration"
    },
    {
      "name": "session"
    },
    {
      "name": "password"
    },
    {
      "name": "email"
    },
    {
      "name": "account"
    },
    {
      "name": "mfa"
    },
    {
      "name": "meta"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "The worker answered",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signup": {
      "post": {
        "tags": [
          "registration"
        ],
        "summary": "Create an account and email a verification link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account created; the verification email is best-effort",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/AccountSummary"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/signin": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Exchange credentials for an access and refresh token pair",
        "description": "Opens a new session. The account is locked for 15 minutes after 10 consecutive failures. When MFA is enabled the response carries `mfa_required: true` and a `challenge_token` instead of tokens; finish with `POST /mfa/verify`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "oneOf": [
                            {
                              "allOf": [
                                {
                                  "$ref": "#/components/schemas/AccountSummary"
                                },
                                {
                                  "$ref": "#/components/schemas/Tokens"
                                }
                              ]
                            },
                            {
                              "$ref": "#/components/schemas/MfaChallenge"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/refresh": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Rotate a refresh token for a new token pair",
        "description": "The presented token is retired. Presenting an already rotated token is treated as a replay and revokes the whole session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New token pair",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "allOf": [
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "email": {
                                  "type": "string",
                                  "format": "email"
                                }
                              }
                            },
                            {
                              "$ref": "#/components/schemas/Tokens"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/signout": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Revoke the session of a refresh token",
        "description": "Idempotent: an unknown or already rotated token still answers 200.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/signout-all": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Revoke every session of the caller",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "List the caller's live sessions",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Session"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}": {
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "Revoke one session of the caller",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/forgot-password": {
      "post": {
        "tags": [
          "password"
        ],
        "summary": "Email a password reset link",
        "description": "The response is identical whether or not the email is registered. At most one email per account per minute.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/reset-password": {
      "get": {
        "tags": [
          "password"
        ],
        "summary": "Render the password reset form",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML form",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "password"
        ],
        "summary": "Set a new password with a reset token",
        "description": "Invalidates every session of the account and marks the email as verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/VerifiedAccount"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/verify-email": {
      "get": {
        "tags": [
          "email"
        ],
        "summary": "Render the email confirmation page",
        "description": "Does not consume the token: mail scanners fetch every link in a message. The page posts to this same path.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML confirmation page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Verify an email address with a token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/VerifiedAccount"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/resend-verification": {
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Email a new verification link",
        "description": "The response is identical for unknown and already verified emails. At most one email per account per minute.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/change-password": {
      "post": {
        "tags": [
          "password"
        ],
        "summary": "Replace the password of the caller",
        "description": "Requires the current password, plus a valid `mfa_code` when the account has MFA enabled. A success revokes every session, including the caller's.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed; sign in again",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/VerifiedAccount"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/account/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "The caller's account",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/Account"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": [
          "account"
        ],
        "summary": "Permanently delete the caller's account",
        "description": "Requires the password, plus a valid `mfa_code` when the account has MFA enabled. Every token of the account is removed by cascade.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/account/{account_id}": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "A single account (self only)",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/Account"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/mfa": {
      "get": {
        "tags": [
          "mfa"
        ],
        "summary": "Whether MFA is enabled for the caller",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "MFA status",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/MfaStatus"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/mfa/totp/setup": {
      "post": {
        "tags": [
          "mfa"
        ],
        "summary": "Start a TOTP enrolment",
        "description": "Returns the base32 secret and the `otpauth://` URI. MFA is not enforced until a code is confirmed, so an abandoned setup cannot lock the account out.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Secret to scan",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/MfaSetup"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/mfa/totp/confirm": {
      "post": {
        "tags": [
          "mfa"
        ],
        "summary": "Activate the enrolment and get recovery codes",
        "description": "The recovery codes are returned exactly once; only their hashes are stored.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MFA enabled",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/MfaConfirm"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/mfa/disable": {
      "post": {
        "tags": [
          "mfa"
        ],
        "summary": "Turn MFA off",
        "description": "Requires both the password and a valid second factor.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaDisableRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptySuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/mfa/verify": {
      "post": {
        "tags": [
          "mfa"
        ],
        "summary": "Exchange the sign-in challenge for tokens",
        "description": "Accepts a 6-digit TOTP code or a recovery code. Five wrong codes destroy the ticket and the password must be entered again.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/AccountSummary"
                            },
                            {
                              "$ref": "#/components/schemas/Tokens"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mfa/recovery-codes": {
      "post": {
        "tags": [
          "mfa"
        ],
        "summary": "Reissue the recovery codes",
        "description": "Replaces every recovery code with a fresh set. Requires the password and a valid second factor.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaDisableRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New recovery codes",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "$ref": "#/components/schemas/MfaConfirm"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from /signin or /refresh. Lifetime is 15 minutes."
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "success",
          "errors",
          "messages",
          "results"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 0
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "results": {}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "success",
          "errors",
          "messages",
          "results"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Human readable reason for the failure."
          },
          "results": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "AccountSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Account": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountSummary"
          },
          {
            "type": "object",
            "required": [
              "is_verified"
            ],
            "properties": {
              "is_verified": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "VerifiedAccount": {
        "type": "object",
        "required": [
          "id",
          "email",
          "is_verified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "is_verified": {
            "type": "boolean"
          }
        }
      },
      "Tokens": {
        "type": "object",
        "required": [
          "token_type",
          "access_token",
          "refresh_token",
          "access_token_expires_at",
          "refresh_token_expires_at"
        ],
        "properties": {
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string",
            "description": "64 hex characters. Store it server-side or in memory; it is single use."
          },
          "access_token_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "refresh_token_expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "expires_at",
          "current"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Session (refresh token family) id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "current": {
            "type": "boolean",
            "description": "True for the session that made the request"
          }
        }
      },
      "SignUpRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "confirm_password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 19
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "confirm_password": {
            "type": "string"
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "EmailRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": [
          "token",
          "password",
          "confirm_password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "confirm_password": {
            "type": "string"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password",
          "confirm_password"
        ],
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "confirm_password": {
            "type": "string"
          },
          "mfa_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when the account has MFA enabled."
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1
          },
          "mfa_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when the account has MFA enabled."
          }
        }
      },
      "MfaStatus": {
        "type": "object",
        "required": [
          "enabled",
          "recovery_codes_remaining"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "recovery_codes_remaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MfaSetup": {
        "type": "object",
        "required": [
          "secret",
          "otpauth_uri"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret for manual entry"
          },
          "otpauth_uri": {
            "type": "string",
            "description": "Render this as a QR code"
          }
        }
      },
      "MfaConfirm": {
        "type": "object",
        "required": [
          "recovery_codes"
        ],
        "properties": {
          "recovery_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shown once. Each code works a single time."
          }
        }
      },
      "MfaChallenge": {
        "type": "object",
        "required": [
          "mfa_required",
          "challenge_token",
          "challenge_expires_at"
        ],
        "properties": {
          "mfa_required": {
            "type": "boolean",
            "const": true
          },
          "challenge_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "challenge_expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MfaCodeRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "MfaDisableRequest": {
        "type": "object",
        "required": [
          "password",
          "code"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "MfaVerifyRequest": {
        "type": "object",
        "required": [
          "challenge_token",
          "code"
        ],
        "properties": {
          "challenge_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "code": {
            "type": "string",
            "description": "TOTP code or recovery code"
          }
        }
      }
    },
    "responses": {
      "EmptySuccess": {
        "description": "The operation succeeded",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                },
                {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid payload or token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired access token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The account exists but may not perform this action (e.g. unverified email, another account)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource does not exist or does not belong to the caller",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Conflict": {
        "description": "The resource already exists",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Per-IP rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
