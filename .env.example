# Public domain of this API, example: auth.example.com
# Also used to build verification links (https://$DOMAIN/api/v1/...);
# leave it blank during local development to fall back to http://localhost:8787
DOMAIN=""
# Run the following command to get DB_UUID
# cf d1 create --name auth-worker
DB_UUID=""
# Run the following command to get PASSWORD_PEPPER (required: the worker refuses
# to hash passwords without it)
# openssl rand -base64 32
PASSWORD_PEPPER=""
# Secret used to sign access tokens (JWT). Use a different value than PASSWORD_PEPPER.
# Required: the worker refuses to issue tokens without it.
# openssl rand -base64 48
JWT_SECRET=""
# Sender address for transactional emails, e.g. "Auth <no-reply@example.com>"
# The domain must be onboarded to Cloudflare Email Service before deploying.
EMAIL_FROM="no-reply@example.com"
# Browser origins allowed to call this API (CORS), comma separated.
# Leave it blank for same-origin only, e.g. "https://app.example.com,http://localhost:5173"
# Use "*" to allow every origin (the API uses bearer headers, not cookies).
CORS_ORIGINS=""
